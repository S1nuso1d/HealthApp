# Скопируй в `.env` и подставь свои значения.
# Положи файл сюда: `HealthApp-back/backend/.env` (рядом с папкой `app/`), либо в `HealthApp-back/.env`.

# --- Окружение ---
# dev — разрешены небезопасные значения ниже (только предупреждения в логах).
# production — сервер НЕ запустится с дефолтным SECRET_KEY, CORS «*» или SQLite.
APP_ENV=dev

# --- JWT (не меняй между перезапусками, иначе все клиенты разлогинятся) ---
# Сгенерировать ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Refresh-токены одноразовые: при обновлении выдаётся новая пара, старая перестаёт
# работать. Повторное использование старого токена завершает все сессии пользователя.
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# В production перечисли домены через запятую: https://app.example.com,https://example.com
ALLOWED_ORIGINS=*

# --- Ограничение частоты запросов (формат «запросов/секунд») ---
# Счётчики в памяти процесса: при нескольких воркерах лимит действует на каждый отдельно.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_UPLOAD=30/60
RATE_LIMIT_AI=20/60

# --- Логи ---
# LOG_FORMAT=json удобен для Loki/ELK, text — для локальной разработки.
# В каждой строке есть request_id, он же возвращается в заголовке X-Request-ID.
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Загрузки ---
AVATAR_MAX_BYTES=5242880
FOOD_RECOGNITION_MAX_BYTES=8388608

# --- Почта: код подтверждения при регистрации ---
# Пока SMTP_HOST пустой, письма НЕ отправляются — код выводится в консоль сервера
# строкой вида: [HealthApp mail dev] Код подтверждения для user@mail.com: 123456
#
# Mail.ru: в SMTP_PASSWORD нужен «ПАРОЛЬ ПРИЛОЖЕНИЯ» для внешних программ, НЕ пароль входа в почту.
# Создание: https://help.mail.ru/mail/security/protection/external
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=you@mail.ru
SMTP_PASSWORD=
SMTP_FROM=you@mail.ru
SMTP_USE_TLS=true
# Если 587 не работает, попробуй Mail.ru с SSL: SMTP_PORT=465 и SMTP_USE_SSL=true (SMTP_USE_TLS=false)
SMTP_USE_SSL=false
# --- LLM: Ollama (локально) или OpenAI ---
# Ollama: установите https://ollama.com, затем:
#   ollama serve
#   ollama pull qwen2.5:14b
#
# Модели (локально, через Ollama):
#   qwen2.5:14b  — рекомендуется: баланс качества и скорости (нужно ~10 ГБ VRAM/RAM)
#   qwen2.5:7b   — быстрее для плана питания (меню ~1–2 мин вместо 2–3)
#   qwen2.5:32b  — мощнее, но в 2–3 раза медленнее (нужно ~20+ ГБ VRAM)
#   llama3.1:8b  — альтернатива, хорош для чата
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=qwen2.5:14b
# Только план питания — легче и быстрее (чат и советы остаются на 14b):
#   ollama pull qwen2.5:7b
LLM_MEAL_PLAN_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.3
# Таймзона для советов ИИ (сон, вода, активность по времени суток)
APP_TIMEZONE=Europe/Moscow
# Для OpenAI: LLM_PROVIDER=openai, LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-...
LLM_API_KEY=
AI_FALLBACK_ENABLED=true

# Примеры провайдеров (смотри их документацию по SMTP):
# Gmail: smtp.gmail.com, порт 587, TLS; нужен «пароль приложения», не обычный пароль.
# Mail.ru: smtp.mail.ru — обязателен пароль приложения для SMTP (см. ссылку выше).
# Yandex: smtp.yandex.ru
